# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=10000

# Authentication
VITE_JWT_SECRET_KEY=your_jwt_secret_here
VITE_TOKEN_EXPIRY=7d

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/avi,video/mov

# Environment
VITE_NODE_ENV=development
VITE_APP_NAME=City State News Portal
VITE_APP_VERSION=1.0.0

# Database (if using MongoDB/PostgreSQL)
VITE_DB_HOST=localhost
VITE_DB_PORT=27017
VITE_DB_NAME=city_state_news

# Email Configuration (for notifications)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your_email@gmail.com
VITE_SMTP_PASS=your_app_password

# Cloud Storage (for file uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_API_SECRET=your_api_secret

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/citystatenews
VITE_TWITTER_URL=https://twitter.com/citystatenews
VITE_INSTAGRAM_URL=https://instagram.com/citystatenews

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Admin Configuration
VITE_ADMIN_EMAIL=admin@citystatenews.com
VITE_DEFAULT_ADMIN_PASSWORD=admin123